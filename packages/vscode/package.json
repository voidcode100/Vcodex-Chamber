{
  "name": "openchamber",
  "displayName": "Vcodex-Chamber",
  "description": "Codex coding chat with paired Windows screenshots, dictation and a Markdown teleprompter.",
  "version": "1.0.0",
  "publisher": "fedaykindev",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/voidcode100/Vcodex-Chamber.git"
  },
  "qna": false,
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "codex",
    "ai",
    "coding",
    "chatgpt",
    "voice",
    "teleprompter",
    "openchamber"
  ],
  "icon": "assets/app-icon.png",
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:openchamber.openSidebar",
    "onCommand:openchamber.attachExplorerToChat",
    "onCommand:captureCodex.openPrompter",
    "onCommand:captureCodex.startVoice",
    "onCommand:captureCodex.stopVoice",
    "onCommand:captureCodex.toggleReceiver",
    "onCommand:captureCodex.getWindowsSenderSettings",
    "onCommand:captureCodex.updateWindowsSenderSettings",
    "onCommand:captureCodex.setSessionPrompt",
    "onView:openchamber.chatView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openchamber",
          "title": "Vcodex-Chamber",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "openchamber": [
        {
          "type": "webview",
          "id": "openchamber.chatView",
          "name": "%views.chat.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "openchamber.openSidebar",
        "category": "Vcodex-Chamber",
        "title": "%command.openSidebar.title%",
        "icon": {
          "light": "assets/icon.svg",
          "dark": "assets/icon-titlebar.svg"
        }
      },
      {
        "command": "openchamber.focusChat",
        "category": "Vcodex-Chamber",
        "title": "%command.focusChat.title%"
      },
      {
        "command": "openchamber.restartApi",
        "category": "Vcodex-Chamber",
        "title": "%command.restartApi.title%"
      },
      {
        "command": "openchamber.showOpenCodeStatus",
        "category": "Vcodex-Chamber",
        "title": "%command.showOpenCodeStatus.title%"
      },
      {
        "command": "openchamber.openAgentManager",
        "category": "Vcodex-Chamber",
        "title": "%command.openAgentManager.title%",
        "icon": "$(repo-forked)"
      },
      {
        "command": "openchamber.openActiveSessionInEditor",
        "category": "Vcodex-Chamber",
        "title": "%command.openActiveSessionInEditor.title%",
        "icon": "$(link-external)"
      },
      {
        "command": "openchamber.openNewSessionInEditor",
        "category": "Vcodex-Chamber",
        "title": "%command.openNewSessionInEditor.title%",
        "icon": {
          "light": "assets/icon.svg",
          "dark": "assets/icon-titlebar.svg"
        }
      },
      {
        "command": "openchamber.openCurrentOrNewSessionInEditor",
        "category": "Vcodex-Chamber",
        "title": "%command.openCurrentOrNewSessionInEditor.title%",
        "icon": "$(link-external)"
      },
      {
        "command": "openchamber.addToContext",
        "category": "Vcodex-Chamber",
        "title": "%command.addToContext.title%"
      },
      {
        "command": "openchamber.addLineComment",
        "category": "Vcodex-Chamber",
        "title": "%command.addLineComment.title%"
      },
      {
        "command": "openchamber.submitLineComment",
        "category": "Vcodex-Chamber",
        "title": "%command.submitLineComment.title%"
      },
      {
        "command": "openchamber.removeLineComment",
        "category": "Vcodex-Chamber",
        "title": "%command.removeLineComment.title%",
        "icon": "$(close)"
      },
      {
        "command": "openchamber.explain",
        "category": "Vcodex-Chamber",
        "title": "%command.explain.title%"
      },
      {
        "command": "openchamber.improveCode",
        "category": "Vcodex-Chamber",
        "title": "%command.improveCode.title%"
      },
      {
        "command": "openchamber.newSession",
        "category": "Vcodex-Chamber",
        "title": "%command.newSession.title%",
        "icon": "$(add)"
      },
      {
        "command": "openchamber.showSettings",
        "category": "Vcodex-Chamber",
        "title": "%command.showSettings.title%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "openchamber.attachExplorerToChat",
        "category": "Vcodex-Chamber",
        "title": "%command.attachExplorerToChat.title%"
      },
      {
        "command": "captureCodex.openPrompter",
        "category": "Vcodex-Chamber",
        "title": "Open Teleprompter"
      },
      {
        "command": "captureCodex.showLogs",
        "category": "Vcodex-Chamber",
        "title": "Show Logs"
      },
      {
        "command": "captureCodex.installAudio",
        "category": "Vcodex-Chamber",
        "title": "Install Bundled Microphone Extension"
      },
      {
        "command": "captureCodex.login",
        "category": "Vcodex-Chamber",
        "title": "Sign in to GPT"
      },
      {
        "command": "captureCodex.logout",
        "category": "Vcodex-Chamber",
        "title": "Sign out of GPT"
      },
      {
        "command": "captureCodex.refreshAuth",
        "category": "Vcodex-Chamber",
        "title": "Refresh sign-in status"
      }
    ],
    "submenus": [
      {
        "id": "openchamber.submenu",
        "label": "Vcodex-Chamber"
      }
    ],
    "menus": {
      "comments/commentThread/context": [
        {
          "command": "openchamber.submitLineComment",
          "group": "inline",
          "when": "commentController == openchamber.inlineComments"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "openchamber.removeLineComment",
          "group": "navigation",
          "when": "commentController == openchamber.inlineComments && commentThread == openchamberAttached"
        }
      ],
      "commandPalette": [
        {
          "command": "openchamber.submitLineComment",
          "when": "false"
        },
        {
          "command": "openchamber.removeLineComment",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "submenu": "openchamber.submenu",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "openchamber.attachExplorerToChat",
          "when": "resourceScheme == file && explorerResourceIsFolder == false",
          "group": "navigation@50"
        }
      ],
      "editor/title": [
        {
          "command": "openchamber.openNewSessionInEditor",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "openchamber.newSession",
          "when": "view == openchamber.chatView",
          "group": "navigation@1"
        },
        {
          "command": "openchamber.openCurrentOrNewSessionInEditor",
          "when": "view == openchamber.chatView",
          "group": "navigation@2"
        },
        {
          "command": "openchamber.openAgentManager",
          "when": "view == openchamber.chatView",
          "group": "navigation@3"
        },
        {
          "command": "openchamber.showSettings",
          "when": "view == openchamber.chatView",
          "group": "navigation@4"
        }
      ],
      "openchamber.submenu": [
        {
          "command": "openchamber.explain"
        },
        {
          "command": "openchamber.improveCode"
        },
        {
          "command": "openchamber.addToContext"
        },
        {
          "command": "openchamber.addLineComment"
        }
      ]
    },
    "configuration": {
      "title": "Vcodex-Chamber",
      "properties": {
        "captureCodex.language": {
          "type": "string",
          "enum": [
            "auto",
            "zh-CN",
            "en"
          ],
          "default": "auto",
          "description": "Vcodex-Chamber interface language."
        },
        "captureCodex.captureDirectory": {
          "type": "string",
          "default": ".codex-capture",
          "description": "Workspace-relative directory for received screenshots."
        },
        "captureCodex.initialPrompt": {
          "type": "string",
          "default": "",
          "description": "Prompt sent before the first screenshot in a new Codex thread."
        },
        "captureCodex.capture.targetMode": {
          "type": "string",
          "enum": [
            "active",
            "pinned"
          ],
          "default": "active",
          "description": "Send WindowsSender captures to the active session or a pinned session."
        },
        "captureCodex.capture.targetSessionId": {
          "type": "string",
          "default": "",
          "description": "Pinned Codex session ID used for WindowsSender captures and voice input."
        },
        "captureCodex.codexBinary": {
          "type": "string",
          "default": "",
          "description": "Optional Codex CLI executable override. Vcodex-Chamber otherwise uses its bundled CLI, CODEX_HOME, or PATH."
        },
        "captureCodex.receiver.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Accept authenticated screenshot uploads from the Windows capture client."
        },
        "captureCodex.receiver.address": {
          "type": "string",
          "default": "0.0.0.0",
          "description": "Address used by the screenshot receiver."
        },
        "captureCodex.receiver.port": {
          "type": "number",
          "default": 43127,
          "minimum": 1024,
          "maximum": 65535,
          "description": "HTTPS screenshot receiver port."
        },
        "captureCodex.receiver.token": {
          "type": "string",
          "default": "",
          "description": "Bearer pairing token for the Windows capture client."
        },
        "captureCodex.voice.transcriptionUrl": {
          "type": "string",
          "default": "",
          "description": "Optional OpenAI-compatible audio/transcriptions URL. Leave empty to use Codex ChatGPT dictation or the signed-in OpenAI API account."
        },
        "captureCodex.voice.inputDevice": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Compatibility setting for Vcodex Audio ARM. Prefer vcodexAudio.inputDevice in the independent plugin settings.",
          "deprecationMessage": "Use vcodexAudio.inputDevice in Vcodex Audio ARM."
        },
        "captureCodex.voice.language": {
          "type": "string",
          "default": "",
          "description": "Optional dictation language hint, for example zh or en. Leave empty for automatic detection. ChatGPT dictation reuses Codex sign-in and does not require a separate API key."
        },
        "captureCodex.voice.transcriptionModel": {
          "type": "string",
          "default": "gpt-4o-mini-transcribe",
          "description": "Model name sent to the configured transcription endpoint."
        },
        "captureCodex.voice.transcriptionApiKey": {
          "type": "string",
          "default": "",
          "description": "Optional bearer token for the configured transcription endpoint."
        },
        "captureCodex.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug"
          ],
          "default": "info",
          "description": "Vcodex-Chamber output log level."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node ../../scripts/vscode-prepublish.mjs",
    "build": "bun run build:extension && bun run build:webview",
    "build:extension": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify --main-fields=module,main",
    "build:webview": "VITE_OPENCODE_URL=/api vite build",
    "stage:codex": "node ../../scripts/stage-codex-binary.mjs",
    "dev": "concurrently -n \"ext,web\" -c \"cyan,magenta\" \"bun run watch:extension\" \"bun run dev:webview\"",
    "dev:webview": "vite --host localhost --port 5173 --strictPort",
    "watch:extension": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch --sourcemap --main-fields=module,main",
    "watch:webview": "vite build --watch",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json",
    "lint": "bun x eslint --ext .ts,.tsx src webview",
    "test": "node ../../scripts/run-isolated-tests.mjs src webview",
    "test:dictation-transport": "node ../../scripts/verify-dictation-transport.mjs",
    "test:windowssender": "node ../../scripts/verify-windowssender.mjs",
    "package": "node ../../scripts/build-vsix.mjs"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/ws": "^8.18.1",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vscode/vsce": "^3.2.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.2"
  },
  "dependencies": {
    "@openchamber/ui": "workspace:*",
    "@opencode/client": "2.0.22",
    "adm-zip": "^0.6.0",
    "https-proxy-agent": "7.0.6",
    "jsonc-parser": "^3.3.1",
    "selfsigned": "^5.5.0",
    "ws": "^8.18.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "yaml": "^2.8.1"
  },
  "homepage": "https://github.com/voidcode100/Vcodex-Chamber",
  "bugs": {
    "url": "https://github.com/voidcode100/Vcodex-Chamber/issues"
  }
}
