{
  "name": "vcodex-chamber",
  "version": "1.0.0",
  "description": "Codex app-server client based on OpenChamber, with Windows capture controls and a teleprompter.",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "packages/sdk/examples/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "codex",
    "vscode",
    "windows",
    "voice",
    "teleprompter",
    "openchamber"
  ],
  "author": "Vcodex-Chamber contributors",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev-vscode.mjs",
    "build": "bun run --cwd packages/vscode build",
    "type-check": "bun run --cwd packages/vscode type-check && bun run --cwd packages/ui type-check",
    "test": "node scripts/verify-windowssender.mjs && node scripts/verify-dictation-transport.mjs",
    "test:ui": "node scripts/verify-windowssender-ui.mjs && node scripts/verify-auth-gate.mjs && node scripts/verify-teleprompter.mjs",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1",
    "postinstall": "bun run --cwd packages/sdk build",
    "vscode:dev": "node scripts/dev-vscode.mjs",
    "vscode:build": "bun run --cwd packages/vscode build",
    "vscode:package": "bun run --cwd packages/vscode package",
    "vscode:type-check": "bun run --cwd packages/vscode type-check"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@heroui/scroll-shadow": "^2.3.18",
    "@heroui/system": "^2.4.23",
