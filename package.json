    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^16.3.0",
    "node-addon-api": "7.1.1",
    "nodemon": "^3.1.7",
    "oxlint": "1.78.0",
    "playwright": "1.62.1",
    "sharp": "^0.35.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.3.8",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/voidcode100/Vcodex-Chamber.git"
  },
